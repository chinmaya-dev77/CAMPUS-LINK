# CampusLink Backend — Environment Variables
# Copy this file to .env and fill in the values for your environment.

# ─── Server ───────────────────────────────────────────────────
PORT=5000

# ─── Database ─────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/campuslink
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campuslink
MONGODB_URI=mongodb://localhost:27017/campuslink

# ─── Authentication ───────────────────────────────────────────
# Generate a strong random secret for production.
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# ─── Transactional email (Gmail SMTP) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusLink <campuslink@example.com>

# ─── AI Provider (Provider-Neutral) ───────────────────────────
# The selected LLM provider will be configured here.
# Supported values (to be decided in Phase 3): groq | openai | gemini
AI_PROVIDER=
LLM_MODEL=
AI_VISION_MODEL=
EMBEDDING_MODEL=

# The API key for the selected AI provider.
AI_API_KEY=

# Maximum number of retries for AI API calls.
AI_MAX_RETRIES=2

# Bounded retry policy for bulk resume analysis only (interactive assistant and
# other AI requests retain AI_MAX_RETRIES/default retry behavior).
RESUME_AI_MAX_RETRIES=2
RESUME_AI_BACKOFF_MS=1500
RESUME_AI_MAX_BACKOFF_MS=30000

# ─── Python ML Service ────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ─── File Uploads ─────────────────────────────────────────────
# Maximum upload size in bytes (default 10 MB)
MAX_FILE_SIZE=10485760

# ─── Cloudinary private asset storage ─────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
